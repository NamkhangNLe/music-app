# Copy this file to .env in this directory (src/backend/.env), then fill
# in your own values. Never commit real keys or connection strings.

# YouTube Data API v3 key. Get one in Google Cloud Console
# (APIs & Services > Credentials > Create API key, restrict it to the
# YouTube Data API v3). No key = demo mode: the server still starts, but
# /api/search and /api/videos answer 503 with a clear message.
YOUTUBE_API_KEY=

# MongoDB Atlas connection string for user accounts + playlists, e.g.
# mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DATABASE_CONNECTION_URI=

# Backend port (default 8923).
REACT_APP_PORT=8923
